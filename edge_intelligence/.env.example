# =============================================================================
# OpsLens backend configuration (copy to edge_intelligence\.env and edit)
# .env is git-ignored. Never commit API keys, passwords or certificates.
# Values already set in the process environment override this file.
# =============================================================================

# ---- Server -----------------------------------------------------------------
OPSLENS_HOST=127.0.0.1
OPSLENS_PORT=8001
# Optional: keep the SQLite database outside the program folder.
# OPSLENS_DB_PATH=C:\OpsLensData\opslens.db

# ---- AI provider (optional) -------------------------------------------------
# OpsLens starts and works WITHOUT any LLM: alarms, evidence, SOP steps and the
# operator brief are deterministic. The LLM writes the incident diagnosis from
# those facts. Every answer is validated against the record and labelled with
# its true source (AI-generated, deterministic fallback, SOP retrieval only).
#
# Order used for the AI diagnosis:
#   1. Groq (cloud, fast)
#   2. LM Studio on this computer, if Groq is offline, too slow, out of quota
#      or its key is rejected
#   3. An answer built from the record, clearly labelled "not AI-generated"
# Ask OpsLens uses Groq only; without it, it gives the record-based answer.
#
# ---- 1. Groq (requires internet) ----
# Incident readings, alarms and SOP text leave this computer. Turn on Zero Data
# Retention in Groq's Data Controls.
OPSLENS_LLM_PROVIDER=groq
GROQ_API_KEY=
OPSLENS_GROQ_MODEL=openai/gpt-oss-120b
# Several keys, tried in turn when one is rate-limited or rejected (for testing).
# Keys in one Groq account share one limit. Groq's Acceptable Use Policy restricts
# using several accounts to get more usage.
# GROQ_API_KEYS=key1,key2
# How long gpt-oss reasons first: low, medium (default) or high. Medium finds
# causes better; it uses more of the free token limit.
# OPSLENS_GROQ_REASONING=medium
# One extra short call to fix lines the record check removed (default true).
# OPSLENS_DIAG_REPAIR=true
# Ask OpsLens answered by the AI from the diagnosis facts (default true with Groq).
# OPSLENS_ASK_ANALYSIS=true
#
# ---- 2. LM Studio backup (offline) ----
# In LM Studio: download Qwen2.5-7B-Instruct (Q4_K_M), load it with Context
# Length 8192 or more, and start the Local Model API. start_lmstudio.bat (called
# by start_all.bat) checks this for you. Set to false to skip the backup.
OPSLENS_DIAG_LOCAL_BACKUP=true
EDGE_LLM_URL=http://127.0.0.1:1234/v1
# The model name as LM Studio lists it (lms ls, or the Local Model API page).
EDGE_LLM_MODEL=qwen2.5-7b-instruct
# Optional: full path to lms.exe if it is not found automatically.
# OPSLENS_LMS_EXE=C:\Users\you\.lmstudio\bin\lms.exe
OPSLENS_LOCAL_TIMEOUT=60
OPSLENS_LOCAL_CONNECT_TIMEOUT=2
# Diagnosis: longest wait for the first word (includes loading the model and
# reading the prompt on a CPU), the hard limit for one full answer, and the
# longest answer in tokens.
OPSLENS_DIAG_FIRST_TOKEN_TIMEOUT=240
OPSLENS_DIAG_TOTAL_TIMEOUT=600
OPSLENS_DIAG_MAX_TOKENS=1500
#
# ---- Offline only (LM Studio, no Groq) ----
# OPSLENS_LLM_PROVIDER=lmstudio
# OPSLENS_LOCAL_WARMUP=true
#
# ---- 3. Record-based answer ----
# Always available; used when neither model answers.
#
# No AI at all (record-based answers only):
# OPSLENS_LLM_PROVIDER=none
#
# Let the LLM also draft the pipeline guidance text (default false: verbatim SOP steps):
# OPSLENS_GUIDANCE_USE_LLM=false
# OPSLENS_LLM_MAX_CONCURRENCY=3
# OPSLENS_LLM_QUEUE_TIMEOUT=0.25
# OPSLENS_ASSISTANT_SINGLEFLIGHT_TIMEOUT=75
# OPSLENS_ASSISTANT_CONTEXT_WINDOW_MINUTES=30

# ---- SOP retrieval ----------------------------------------------------------
# Qdrant is OPTIONAL. Without it (or without sentence-transformers) OpsLens uses
# BM25 keyword retrieval and says so in /api/health and /api/diagnostics.
# The bundled plant SOPs (SOP-LFT-001 and the rest) are treated as the plant's
# approved procedures. Set to false to show their recorded "Draft for review"
# status again. Uploaded PDFs keep their own approval status.
OPSLENS_PLANT_SOPS_APPROVED=true

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opslens_sops
# Single-process embedded Qdrant instead of a service:
# QDRANT_URL=embedded
# QDRANT_PATH=./qdrant_data

# ---- Alarm reference (derived from SOP-MAN-000, page-cited) -----------------
# OPSLENS_ALARM_REFERENCE=./config/alarm_reference.json

# ---- Shift handover ---------------------------------------------------------
# 24-hour HH:MM in this PC's local time. Leave blank to show "not configured".
# A rotation covers every hour; the person icon on the HMI shows the shift running now.
# If this line is missing, this same Morning/Evening/Night rotation is used.
OPSLENS_SHIFTS=Morning:06:00-14:00,Evening:14:00-22:00,Night:22:00-06:00
# Or a single shift: set OPSLENS_SHIFTS= (empty). Outside its hours the HMI
# says no shift is in progress.
OPSLENS_SHIFT_NAME=Night
OPSLENS_SHIFT_START=18:00
OPSLENS_SHIFT_END=06:00

# ---- Past month of history (Scenario Lab) -----------------------------------
# On first start, add ~23 resolved past incidents and 30 days of readings,
# labelled "simulated history", so Related Incidents and the alarm summary have
# something to show. Kept until the database is reset or removed in Scenario Lab.
# Impact metrics exclude them. Set to false to start with an empty history.
OPSLENS_SEED_HISTORY=true

# ---- Scenario Lab -----------------------------------------------------------
# A run still marked "running" after this many seconds is treated as stale.
OPSLENS_SCENARIO_STALE_SECONDS=600

# ---- Read-only PLC (OPC UA) -------------------------------------------------
# Disabled until a real endpoint and an explicit NodeId mapping are supplied.
# See PLC_OPCUA_SETUP.md. OpsLens never writes to the PLC.
PLC_OPCUA_ENABLED=false
PLC_OPCUA_ENDPOINT=
PLC_OPCUA_SECURITY_POLICY=
PLC_OPCUA_SECURITY_MODE=None
PLC_OPCUA_USERNAME=
PLC_OPCUA_PASSWORD=
PLC_OPCUA_CLIENT_CERTIFICATE=
PLC_OPCUA_CLIENT_PRIVATE_KEY=
PLC_OPCUA_PRIVATE_KEY_PASSWORD=
PLC_OPCUA_SERVER_CERTIFICATE=
PLC_OPCUA_TAG_MAPPING=./plc_tag_mapping.json
PLC_OPCUA_POLL_INTERVAL=1
PLC_OPCUA_RECONNECT_MIN_SECONDS=1
PLC_OPCUA_RECONNECT_MAX_SECONDS=30
PLC_OPCUA_STALE_AFTER_SECONDS=10

# --- Metrics page (optional) ----------------------------------------------
# An ASSUMED "time to fix before OpsLens", in minutes, so the Metrics page can
# show "Change vs baseline". It is labelled as assumed on screen. A value typed
# on the Metrics page overrides it. Leave empty for no baseline.
OPSLENS_BASELINE_MTTR_MIN=

# --- SOP search ------------------------------------------------------------
# SOP search tries Qdrant first, then BM25, checked against the alarm-tag link.
# On start, the backend adds the plant's SOP sections to Qdrant when it is running.
OPSLENS_INDEX_PLANT_SOPS=true
